APP_NAME=bookslot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Runtime connection — the ONLY role the running application ever
# authenticates as (ordinary, fully RLS-subject). See D-0009/D-0020.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bookslot
DB_USERNAME=bookslot_app
DB_PASSWORD=bookslot_app_local_only

# Migrator connection — holds BYPASSRLS, owns the tables. Used only for
# migrations/seeders/backfills, never by the running application. Per
# D-0020, this credential must stay out of the application's ordinary
# runtime secrets and out of any general CI/CD secret store.
DB_MIGRATOR_HOST=127.0.0.1
DB_MIGRATOR_PORT=5432
DB_MIGRATOR_DATABASE=bookslot
DB_MIGRATOR_USERNAME=bookslot_migrator
DB_MIGRATOR_PASSWORD=bookslot_migrator_local_only

# D-0029: owner/staff/platform_admin authenticate via Sanctum SPA
# (stateful/cookie) mode, which needs a real, persisted session store —
# Redis, already provisioned for cache/queue below, rather than a new
# sessions table. Public customer-facing endpoints remain stateless
# (SetTenantContext never touches the session); only requests from a
# configured SANCTUM_STATEFUL_DOMAINS origin get the session/CSRF
# middleware group at all (see EnsureFrontendRequestsAreStateful).
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The decoupled Nuxt frontend's origin(s) (03-architecture.md) — used both
# for CORS (config/cors.php) and Sanctum's stateful-domain check
# (config/sanctum.php). FRONTEND_URLS carries full origins (scheme +
# host[:port]) for CORS; SANCTUM_STATEFUL_DOMAINS carries host[:port] only,
# per Sanctum's own expected format.
FRONTEND_URLS=http://localhost:3000,http://127.0.0.1:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Redis-backed queues (Horizon) per 03-architecture.md/08-deployment-and-operations.md.
QUEUE_CONNECTION=redis
CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe Connect (test-mode keys only in local/staging — see
# 08-deployment-and-operations.md's test/live separation guard).
#
# D-0036: this project has formally, permanently descoped ever obtaining
# real Stripe test-mode credentials — a deliberate portfolio/skill-proof
# scope decision, not a technical or access blocker (see
# docs/project-memory/09-decision-log.md D-0036, R-07 in
# 10-risk-register.md). The values below are unambiguous placeholders,
# NOT real credentials — Stripe's real API rejects them outright the
# instant a real call is attempted. Do not replace them with a real key
# in this project's normal course. `FakePaymentIntentGateway`
# (07-testing-strategy.md's faked-Stripe-client tier) is the permanent
# stand-in for Stripe validation in this codebase, not a temporary one.
STRIPE_SECRET_KEY=sk_test_PLACEHOLDER_NOT_REAL
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER_NOT_REAL
STRIPE_APPLICATION_FEE_BPS=0
