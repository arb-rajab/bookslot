APP_NAME=bookslot
APP_ENV=testing
APP_KEY=base64:ENk2rEszVwq/ZqDM0V4nZTtqQgiS0OiUw4a+9ifq8eE=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# 07-testing-strategy.md is explicit: SQLite cannot express tstzrange, GIST,
# or RLS, so every DB-touching test runs against real Postgres — a
# dedicated `bookslot_test` database, never the local dev `bookslot` one.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bookslot_test
DB_USERNAME=bookslot_app
DB_PASSWORD=bookslot_app_local_only

DB_MIGRATOR_HOST=127.0.0.1
DB_MIGRATOR_PORT=5432
DB_MIGRATOR_DATABASE=bookslot_test
DB_MIGRATOR_USERNAME=bookslot_migrator
DB_MIGRATOR_PASSWORD=bookslot_migrator_local_only

# D-0029: kept as 'array' here deliberately (same reasoning as the queue/
# cache overrides below) — within a single Pest test, Laravel's testing
# HTTP client reuses one $this->app/SessionManager instance across
# sequential requests, so the array driver's in-memory store persists for
# exactly as long as a real CSRF/login flow test needs, with no Redis
# dependency in the fast gate.
SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# Matches a Feature test's Origin header — Sanctum's
# EnsureFrontendRequestsAreStateful only applies the session/CSRF
# middleware group to a request that presents one of these as its
# Referer/Origin (see config/sanctum.php).
FRONTEND_URLS=http://localhost,http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000

# Sync/array so the fast gate never depends on a running Redis instance —
# jobs execute inline, in-process, which is also what lets the
# tenant-isolation suite assert on job behavior directly.
QUEUE_CONNECTION=sync
CACHE_STORE=array

MAIL_MAILER=array

STRIPE_SECRET_KEY=sk_test_dummy_for_tests
STRIPE_WEBHOOK_SECRET=whsec_dummy_for_tests
STRIPE_APPLICATION_FEE_BPS=500

PULSE_ENABLED=false
TELESCOPE_ENABLED=false
NIGHTWATCH_ENABLED=false
