# The real Laravel API this app calls (03-architecture.md's decoupled
# split, D-0002) — never a mock. Defaults already match this repository's
# own `php artisan serve` port, so local development needs no .env at all
# unless the API runs somewhere else.
NUXT_PUBLIC_API_ORIGIN=http://localhost:8000
NUXT_PUBLIC_API_BASE=http://localhost:8000/api
